server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Compression des assets statiques
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1000;

    # Reverse-proxy des appels API vers le backend FastAPI.
    # ${BACKEND_HOST} : substitué au démarrage du conteneur (envsubst, cf.
    # Dockerfile) — "backend:8000" en local (docker-compose), l'hôte réseau
    # privé du service Railway en production. Fichier nommé *.template dans
    # /etc/nginx/templates/ : l'image nginx officielle l'interpole
    # automatiquement vers /etc/nginx/conf.d/ au démarrage.
    location ~ ^/(api|auth|health|uploads|docs|openapi.json) {
        proxy_pass http://${BACKEND_HOST};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # SPA : toute autre route renvoie index.html (routing côté client)
    location / {
        try_files $uri $uri/ /index.html;
    }
}
